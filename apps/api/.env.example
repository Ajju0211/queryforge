# ==============================================================================
# QueryForge AI API - Environment Configuration Template
# ==============================================================================

# Server Settings
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:3000"]

# Internal Application Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://queryforge:queryforge@localhost:5432/queryforge


# Authentication & JWT Security
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Customer Credential Encryption (Fernet / AES-128-CBC + HMAC-SHA256)
ENCRYPTION_MASTER_KEY=
ENCRYPTION_SECONDARY_KEYS=

# Connection Security & SSRF Protection
ALLOW_PRIVATE_NETWORKS=true
CUSTOMER_DB_CONNECT_TIMEOUT_SECONDS=5

# Customer Query Execution Safeguards
STATEMENT_TIMEOUT_MS=15000
MAX_RESULT_ROWS=500

# AI Provider Settings (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
