# ==============================================================================
# AI Database Workspace - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting services.
# NEVER commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Core & Server Settings (apps/api)
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # Options: development, staging, production
PORT=8000
LOG_LEVEL=info                          # Options: debug, info, warning, error
CORS_ORIGINS=["http://localhost:3000"] # Allowed frontend origins

# ------------------------------------------------------------------------------
# 2. Application Database (Internal State)
# ------------------------------------------------------------------------------
# Dedicated PostgreSQL instance storing users, workspaces, metadata, audit logs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_workspace_internal

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Cryptographic secret used to sign session tokens and JWTs.
# Generate via: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 24 hours

# ------------------------------------------------------------------------------
# 4. Customer Credential Encryption (Fernet / AES-128-CBC + HMAC-SHA256)
# ------------------------------------------------------------------------------
# Master encryption key used to encrypt customer database credentials at rest.
# Generate via: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=

# Optional comma-separated list of secondary keys for MultiFernet key rotation.
# When rotating keys: move old master key here and place new key in ENCRYPTION_MASTER_KEY.
ENCRYPTION_SECONDARY_KEYS=

# ------------------------------------------------------------------------------
# 5. Connection Security & SSRF Protection
# ------------------------------------------------------------------------------
# Controls whether connections to private RFC1918, loopback, or local Docker networks
# are permitted. MUST be set to 'false' in production environments to prevent SSRF.
ALLOW_PRIVATE_NETWORKS=true             # Set to 'false' in staging/production

# Default connect socket timeout in seconds
CUSTOMER_DB_CONNECT_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 6. Customer Query Execution Safeguards
# ------------------------------------------------------------------------------
# Maximum query runtime in milliseconds enforced via PostgreSQL statement_timeout
STATEMENT_TIMEOUT_MS=15000              # 15 seconds

# Maximum number of result rows returned to the frontend
MAX_RESULT_ROWS=500

# ------------------------------------------------------------------------------
# 7. AI Provider Settings (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Recommended cost-conscious model with native structured output support
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 8. Web Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
